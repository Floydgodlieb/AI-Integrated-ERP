# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# --- Odoo connection --------------------------------------------------------
# Use the limited "ai_agent" user created by Setup/seed_odoo.py, NOT the administrator.
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=ai_agent
ODOO_PASS=your-ai-agent-password

# --- Optional settings (the values below are the defaults) -------------------
# Seconds to wait for Odoo before giving up
ODOO_TIMEOUT=30
# Maximum number of records one AI read returns
ODOO_READ_LIMIT=50
# false = prices always come from Odoo; true = a price in the AI's request is used
ODOO_ALLOW_AI_PRICES=false
# Seconds the backend waits for approve/decline before cancelling
APPROVAL_TIMEOUT_SECONDS=300
# Audit log file (relative to Application/V3)
AUDIT_LOG_PATH=logs/audit.jsonl
# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Microsoft Teams (optional) ---------------------------------------------
# Leave EMPTY unless you made your own new webhook. (The previous group's webhook leaked - never reuse it.)
TEAMS_WEBHOOK_URL=
